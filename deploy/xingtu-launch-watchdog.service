[Unit]
Description=Xingtu launch cache freshness and recovery watchdog
After=network.target rocket-cloud.service launch-calendar.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/xingtu-launch-watchdog/current/launch-watchdog.py
StateDirectory=xingtu-launch-watchdog
StateDirectoryMode=0700
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
