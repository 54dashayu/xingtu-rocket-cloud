# The Node server reads process environment; source/export this file in your deployment.
PORT=4173
HOST=127.0.0.1
CACHE_TTL_MS=1800000
# One writer only. Point both applications at the SAME file on the shared host.
# LAUNCH_SNAPSHOT_FILE=/absolute/shared/data/launch-snapshot.json
# LAUNCH_FEED_READ_ONLY=false
# Set LAUNCH_FEED_READ_ONLY=true in the secondary calendar service.
# CACHE_FILE=/absolute/shared/data/cache.json
# HISTORY_CACHE_FILE=/absolute/shared/data/history-cache.json
# CALENDAR_ARCHIVE_FILE=/absolute/shared/data/calendar-archive.json
